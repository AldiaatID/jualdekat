{
  "expo": {
    "name": "JualDekat",
    "slug": "jualdekat",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#16A34A"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jualdekat.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "JualDekat butuh akses lokasi untuk menampilkan barang-barang terdekat dari kamu."
      }
    },
    "android": {
      "package": "com.jualdekat.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#16A34A"
      },
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {}
    },
    "experiments": {
      "baseUrl": "/jualdekat"
    },
    "plugins": []
  }
}
